APP_NAME=FocusIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Djibouti
APP_URL=http://127.0.0.1:8001
SERVER_PORT=8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=focusia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true as soon as the site is served over HTTPS (tunnel, production)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@focusia.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- FocusIA ---
# Private disk for uploaded files: "local" (storage/app/private) or "s3" (R2 / B2, later)
FOCUSIA_FILES_DISK=local
FOCUSIA_MAX_UPLOAD_KB=10240
FOCUSIA_SIGNED_URL_MINUTES=10
# "Student in difficulty" thresholds
FOCUSIA_DIFFICULTY_AVERAGE=10
FOCUSIA_DIFFICULTY_NOTION_RATE=0.5
# Extra seconds tolerated between quiz duration and device answer time (offline)
FOCUSIA_QUIZ_GRACE_SECONDS=60
# Login attempts allowed per minute (per e-mail + IP)
FOCUSIA_LOGIN_MAX_ATTEMPTS=5

# Code to give to teachers so they can create their account (empty = teacher sign-up closed)
FOCUSIA_TEACHER_CODE=
